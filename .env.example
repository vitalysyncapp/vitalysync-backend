PORT=3000
NODE_ENV=development

# Browser CORS. Leave empty for open local development; set comma-separated
# HTTPS frontend origins in production, for example:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# To test Flutter web against a deployed backend, explicitly add loopback
# origins. Loopback entries may use a port wildcard:
# CORS_ALLOWED_ORIGINS=https://vitalysync-frontend.onrender.com,http://localhost:*,http://127.0.0.1:*
CORS_ALLOWED_ORIGINS=

# API rate limiting. Set TRUST_PROXY_HOPS=0 for a direct, unproxied deployment.
# Render-style reverse proxy deployments usually need TRUST_PROXY_HOPS=1.
TRUST_PROXY_HOPS=1
RATE_LIMIT_PERIMETER_MAX=1000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_LOGIN_FAILURE_MAX=5
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_EMAIL_VERIFICATION_MAX=5
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_CHANGE_MAX=5
RATE_LIMIT_NUTRITION_ANALYZE_MAX=10
RATE_LIMIT_AI_NUDGE_MAX=20
RATE_LIMIT_REPORT_REFRESH_MAX=10

# PostgreSQL: use DATABASE_URL or the split DB_* settings below.
# Production deployments should use DB_SSL=true unless the database is private
# and the platform provides equivalent transport security.
DATABASE_URL=
DB_SSL=false
DB_USER=postgres
DB_HOST=localhost
DB_NAME=vitalysync
DB_PASSWORD=
DB_PORT=5432

# Required in production. Use a high-entropy value with at least 32 characters.
# Rotate this if it is ever exposed.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=604800
AUTH_CODE_TTL_MINUTES=10
PASSWORD_RESET_GRANT_TTL_MINUTES=10

# External integrations.
# Brevo transactional SMTP. Use the SMTP login and SMTP key from Brevo;
# never use an API key or account password here.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM="VitalySync <verified-sender@example.com>"
# Required for nutrition image and manual meal analysis.
OPENAI_API_KEY=
OPENAI_NUDGE_MODEL=gpt-5.4-mini
OPENAI_NUTRITION_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
USDA_API_KEY=
OPENWEATHER_API_KEY=
