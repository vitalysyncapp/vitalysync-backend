PORT=3000
NODE_ENV=development

# PostgreSQL: use DATABASE_URL or the split DB_* settings below.
DATABASE_URL=
DB_SSL=false
DB_USER=postgres
DB_HOST=localhost
DB_NAME=vitalysync
DB_PASSWORD=
DB_PORT=5432

# Required in production. Used to sign VitalySync bearer tokens.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=604800

# External integrations.
OPENAI_API_KEY=
OPENAI_NUDGE_MODEL=gpt-5.4-mini
OPENAI_NUTRITION_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
USDA_API_KEY=
OPENWEATHER_API_KEY=
