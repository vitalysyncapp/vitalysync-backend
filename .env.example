PORT=3000
NODE_ENV=development

# API rate limiting. Set TRUST_PROXY_HOPS=0 for a direct, unproxied deployment.
TRUST_PROXY_HOPS=1
RATE_LIMIT_PERIMETER_MAX=1000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_LOGIN_FAILURE_MAX=5
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_NUTRITION_ANALYZE_MAX=10
RATE_LIMIT_AI_NUDGE_MAX=20
RATE_LIMIT_REPORT_REFRESH_MAX=10

# PostgreSQL: use DATABASE_URL or the split DB_* settings below.
DATABASE_URL=
DB_SSL=false
DB_USER=postgres
DB_HOST=localhost
DB_NAME=vitalysync
DB_PASSWORD=
DB_PORT=5432

# Required in production. Used to sign VitalySync bearer tokens.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=604800

# External integrations.
OPENAI_API_KEY=
OPENAI_NUDGE_MODEL=gpt-5.4-mini
OPENAI_NUTRITION_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
USDA_API_KEY=
OPENWEATHER_API_KEY=
